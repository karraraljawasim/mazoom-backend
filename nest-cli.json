{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [{
      "include": "features/inventory/lua/**/*",
      "outDir": "dist/src",
      "watchAssets": true
    }],
    "plugins": ["@nestjs/swagger"]
  }
  }
